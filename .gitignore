# Binaries
bin/
build/
*.exe
*.dll
*.so
*.dylib
*.test
*.out
/kaya
/kaya-test
/kaya-web
cmd/kaya/workspace

# Kaya specific
.kaya/
config.json
# Sticky console port — runtime state written by kaya-web on startup.
.console-port
sessions/
build/
tmp/
kaya.service
kaya-web.service
kaya-speech.service

# Coverage
coverage.txt
coverage.html

# Secrets & Config
.env
config/config.json
config/.secrets.json
# Vault master keys — the lock must never travel with the safe.
**/.master-key

# OS
.DS_Store
*.log

# Editors
.vscode/
.idea/

# Editor agent state — per-machine AI tooling should stay local so it never
# shows up in diffs or gets propagated between checkouts.
.codex/
.cursor/
.gemini/
.zed/
.opencode/
.mcp.json
opencode.json
opencode.jsonc

# Goreleaser
dist/

# Workspace Data (Whitelist Approach)
# 1. Ignore EVERYTHING in workspace by default
workspace/*

# 2. Allow structural content (Whitelist)
!workspace/knowledge/
!workspace/skills/
!workspace/README.md
!workspace/cron/README.md
!workspace/memory/README.md
!workspace/state/README.md
!workspace/journal/README.md
!workspace/data/README.md
!workspace/KAYA.md
!workspace/HEARTBEAT.md
# Prompt contract files — persona, identity, and conventions ship with the
# embed like KAYA.md; only USER.md stays per-installation.
!workspace/SOUL.md
!workspace/IDENTITY.md
!workspace/AGENTS.md

# Per-installation identity docs — personalized at runtime, never commit.
# (Tracking these is what made every release build report -dirty.)
workspace/USER.md

# Knowledge — operational state (never commit — changes every session)
# Block individual files within the already-negated knowledge/ directory
workspace/knowledge/self/user-profile.md
workspace/knowledge/self/context.md
workspace/knowledge/self/recent-errors.md
workspace/knowledge/self/skills-state.md
workspace/knowledge/self/channels.md
workspace/knowledge/logs/sessions.md
workspace/knowledge/logs/errors.md
workspace/knowledge/ops/inbox.md
workspace/knowledge/ops/tasks.md

# Bundled-skills manifest — runtime state tracking user edits vs origin
**/.bundled_manifest

# SQLite Database
*.db
*.db-shm
*.db-wal

# Skill package-manager canonical store
.skill-store/

# Personal AI snapshots
backups/

# Python caches
__pycache__/
*.pyc

/cmd/kaya/kaya
/cmd/kaya-web/kaya-web
