[Unit]
Description=Kaya - your personal AI, running locally (per-user)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__KAYA_DIR__
EnvironmentFile=-__KAYA_DIR__/.env
Environment=KAYA_WORKSPACE_DIR=__WORKSPACE_DIR__
ExecStart=__BIN_DIR__/kaya serve
Restart=always
RestartSec=5

# A per-user service already runs as the owner, so no NewPrivileges dance
# is needed; the process simply cannot touch other users' data.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
