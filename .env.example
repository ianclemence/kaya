# ── Kaya Configuration ─────────────────────────────────────────────────────
# System and environment overrides only. Secrets live in .secrets.json.
# ───────────────────────────────────────────────────────────────────────────

# ── Kaya Internal API ─────────────────────────────────────────────────────
# Port where the bridge and remote clients connect
KAYA_API_PORT=8766

# ── System Paths & Environment ─────────────────────────────────────────────
# KAYA_DIR=/var/kaya
# KAYA_CONFIG_DIR=
# KAYA_WORKSPACE_DIR=/var/lib/kaya/workspace  (runtime workspace; outside the install tree)
# KAYA_DB_PATH=/var/lib/kaya/workspace/kaya.db
# MEMORY_DIR=/var/lib/kaya/workspace/memory
# KAYA_RECOVERY_MODE=0
# KAYA_PROFILE=default
# KAYA_INSTANCE_ID=
# TZ=UTC

# ── Remote Bridge Commands ─────────────────────────────────────────────────
# ALLOWED_CMDS=python3,ollama,curl
# SCREENSHOT_CMD=scrot /tmp/kaya-bridge-screen.png

# ── Execution Sandboxing ───────────────────────────────────────────────────
# Model-initiated subprocesses require bubblewrap isolation by default and
# refuse to run without it. Only relax on machines without bwrap:
# KAYA_EXEC_ISOLATION=require (default) | auto (isolate when possible) | off (env sanitization only)

# ── Provider Overrides (Advanced) ──────────────────────────────────────────
# Each provider supports: API_BASE, PROXY, AUTH_METHOD, CONNECT_MODE
# API keys belong in .secrets.json — never put them here.
# KAYA_PROVIDERS_ANTHROPIC_API_BASE=
# KAYA_PROVIDERS_ANTHROPIC_PROXY=
# KAYA_PROVIDERS_OPENAI_API_BASE=
# KAYA_PROVIDERS_OPENAI_PROXY=
# KAYA_PROVIDERS_OPENROUTER_API_BASE=
# KAYA_PROVIDERS_VLLM_API_BASE=http://localhost:8000
